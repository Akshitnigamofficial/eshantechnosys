---
// Hero.astro
---
<section class="hero">
  <div class="hero-overlay"></div>

  <div class="hero-content">
    <div class="hero-card">
      <span class="badge">✨ ENTERPRISE SOFTWARE EXCELLENCE</span>

      <h1>
        Building Tomorrow's
        <span class="gradient-text"> Digital Infrastructure</span>
      </h1>

      <p>
        We deliver cutting-edge enterprise software solutions and robust infrastructure systems.
      </p>

      <div class="hero-buttons">
        <button class="btn-primary">Get Started</button>
        <button class="btn-secondary">Learn More</button>
      </div>
    </div>
  </div>
</section>