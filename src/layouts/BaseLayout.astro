---
const { title = "EshanTechnosys" } = Astro.props;
import "../styles/global.css";
---

<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <title>{title}</title>

    <style>
      :root {
        --bg: #000000;
        --black: #000;
        --accent: #b815a5;
        --yellow: #ffffff;
      }

      body {
        margin: 0;
        font-family: system-ui, sans-serif;
        background: var(--bg);
      }

      * {
        box-sizing: border-box;
      }
    </style>
  </head>

  <body>
    <slot />
  </body>
</html>
