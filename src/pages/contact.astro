---
import BaseLayout from "../layouts/BaseLayout.astro";
import Navbar from "../components/Navbar.jsx";
---

<BaseLayout title="Contact">
  <Navbar client:load />

  <section class="contact-wrapper">

    <div class="contact-grid">

      <!-- LEFT SIDE -->
      <div class="contact-info">

        <h1 class="contact-title">
          Let's Build Something <span class="gradient-text">Amazing</span>
        </h1>

        <p class="contact-subtitle">
          Have a project in mind? Reach out and let's discuss how we can help bring your ideas to life.
        </p>

        <div class="contact-details">
          <p>📧 contact@eshantechnosys.com</p>
          <p>📞 +91 XXXXXXXX</p>
          <p>🌍 India</p>
        </div>

      </div>

      <!-- RIGHT SIDE FORM -->
      <div class="glass squircle-lg contact-form">

        <form>

          <input type="text" placeholder="Your Name" required />
          <input type="email" placeholder="Your Email" required />

          <textarea placeholder="Your Message" rows="5" required></textarea>

          <button type="submit" class="btn-primary squircle-pill">
            Send Message →
          </button>

        </form>

      </div>

    </div>

  </section>
</BaseLayout>